{
    "name": "liquidstack-base",
    "private": true,
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "clean": "node scripts/clean-manifest.js",
        "sync-core": "composer liquidstack-core:sync-resources",
        "prebuild": "npm run clean && npm run sync-core",
        "build": "node scripts/swap-env.mjs production && concurrently \"php App/tools/build-sitemap.php\" \"vite build\"",
        "lad": "node scripts/swap-env.mjs development && node App/tools/liquidstack-dev.mjs"
    },
    "dependencies": {
        "gsap": "npm:@gsap/shockingly@3.12.5",
        "leaflet": "1.9.4",
        "three": "^0.170.0"
    },
    "devDependencies": {
        "concurrently": "9.2.1",
        "fast-glob": "3.3.3",
        "sass": "1.104.0",
        "vite": "^7.3.6",
        "vite-plugin-full-reload": "1.2.0"
    },
    "overrides": {
        "shell-quote": "1.10.0"
    }
}
