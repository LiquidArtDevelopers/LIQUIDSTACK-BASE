    },
    "art08_00_a_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Pertsonak proiektu baten testuingurua partekatzen",
        "title": "Helburuei eta testuinguruari buruzko elkarrizketa"
    },
    "art08_00_headerSecondary_a": {
        "text": "Testuingurua eta helburuak"
    },
    "art08_00_a_p": {
        "text": "Azaldu zer konpondu behar duen proiektuak, nori zuzentzen zaion eta zer material dagoen, abiapuntu errealista identifikatzeko."
    },
    "art08_00_b_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Taldea proiektu baten lehentasunak antolatzen",
        "title": "Lehentasunen definizio partekatua"
    },
    "art08_00_headerSecondary_b": {
        "text": "Irismena eta lehentasunak"
    },
    "art08_00_b_p": {
        "text": "Adosten dugu zein bloke diren ezinbestekoak, zein gehitu daitezkeen geroago eta zer informazio falta den aurrera egin aurretik."
    },

    "moduleH1Type02_00_h1_text": {
        "text": "Hitz egin dezagun zure hurrengo proiektuaz"
    },
    "moduleH1Type02_00_p01_text": {
        "text": "Erabili formulario hau behar bat partekatzeko, informazioa eskatzeko edo lehen bilera proposatzeko. Eremuak oinarri editagarria dira, eta erakunde bakoitzak benetan behar dituen datuetara egokitu behar dira."
    },
    "moduleH1Type02_00_p02_text": {
        "text": "Webgunea argitaratu aurretik, konfiguratu benetako harreman-bideak, lege-testuak eta erantzuteko epeak. Txantiloi honek ez du kokapen, jarduera edo ordutegi jakinik aurresuposatzen."
    },

