    "title": {
        "text": "Harremana | LiquidStack proiektua"
    },

    "description": {
        "content": "Erabili harremanetarako orri modular hau kontsultak jasotzeko eta LiquidStack proiektu bat nola hasten den argi azaltzeko abiapuntu gisa."
    },

