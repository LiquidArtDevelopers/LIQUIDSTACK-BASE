    "sect01_00_a_img01": {
        "src": "assets/img/system/bookmark-outline.svg",
        "alt": "Lehen elkarrizketaren ikonoa",
        "title": "Proiektuari buruzko elkarrizketaren hasiera"
    },
    "sect01_00_a_h3_text": {
        "text": "Lehen harremana"
    },
    "sect01_00_a_p01_text": {
        "text": "Partekatu testuinguru orokorra, helburu nagusia eta proiektua zer fasetan dagoen, elkarrizketa baliagarria prestatzeko."
    },
    "sect01_00_a_p02_text": {
        "text": "Ez da beharrezkoa xehetasun guztiak aldez aurretik zehaztea; nahikoa da lehentasunak eta hasierako zalantzak azaltzea."
    },
    "sect01_00_a_img02": {
        "src": "assets/img/dummy/dummy_900.avif",
        "alt": "Pertsonak kontsulta digital bat prestatzen",
        "title": "Kontsulta bat prestatzea"
    },
    "sect01_00_a_img03": {
        "src": "assets/img/dummy/dummy_900.avif",
        "alt": "Taldea proiektu baten oharrak berrikusten",
        "title": "Hasierako testuingurua berrikustea"
    },
    "sect01_00_a_img04": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Proiektu digital baten hasierako bilera",
        "title": "Proiektuaren lehen bilera"
    },
    "sect01_00_b_img01": {
        "src": "assets/img/system/bookmark-outline.svg",
        "alt": "Beharrak zehazteko ikonoa",
        "title": "Proiektuaren beharrak zehaztea"
    },
    "sect01_00_b_h3_text": {
        "text": "Beharrak zehaztea"
    },
    "sect01_00_b_p01_text": {
        "text": "Eskakizunak, parte hartzen duten pertsonak eta eskuragarri dauden edukiak antolatzen ditugu, funtsezkoa dena eta geroago landu daitekeena bereizteko."
    },
    "sect01_00_b_p02_text": {
        "text": "Fase honek irismen ulergarria zehazten laguntzen du, diseinuari edo garapenari buruzko erabakiak hartu aurretik."
    },
    "sect01_00_b_img02": {
        "src": "assets/img/dummy/dummy_900.avif",
        "alt": "Eskakizunak antolatuta dituen panela",
        "title": "Proiektuaren eskakizunak antolatuta"
    },
    "sect01_00_b_img03": {
        "src": "assets/img/dummy/dummy_900.avif",
        "alt": "Pertsonak partekatutako zereginak lehenesten",
        "title": "Zereginen elkarlaneko lehenespena"
    },
    "sect01_00_b_img04": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Proiektu baten irismenaren eskema",
        "title": "Irismenaren definizio bisuala"
    },
    "sect01_00_c_img01": {
        "src": "assets/img/system/bookmark-outline.svg",
        "alt": "Proposamenaren eta baliozkotzearen ikonoa",
        "title": "Baliozkotzeko prestatutako proposamena"
    },
    "sect01_00_c_h3_text": {
        "text": "Proposamena eta baliozkotzea"
    },
    "sect01_00_c_p01_text": {
        "text": "Soluzio modular bat proposatzen dugu, eta elkarrekin berrikusten ditugu haren egitura, edukiak eta ekintza nagusiak, inplementatu aurretik."
    },
    "sect01_00_c_p02_text": {
        "text": "Erabakiak erregistratuta geratzen dira, hurrengo urratsa partekatutako erreferentzia batetik abiatzeko."
    },
    "sect01_00_c_img02": {
        "src": "assets/img/dummy/dummy_900.avif",
        "alt": "Pertsonak proposamen digital bat berrikusten",
        "title": "Proposamen bat berrikustea"
    },
    "sect01_00_c_img03": {
        "src": "assets/img/dummy/dummy_900.avif",
        "alt": "Taldea web-egitura bat baliozkotzen",
        "title": "Egituraren baliozkotzea"
    },
    "sect01_00_c_img04": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Soluzio modular baten aurkezpena",
        "title": "Proiektuaren proposamen modularra"
    },
    "sect01_00_d_img01": {
        "src": "assets/img/system/bookmark-outline.svg",
        "alt": "Abiaraztearen ikonoa",
        "title": "Proiektuaren hasiera eta jarraipena"
    },
    "sect01_00_d_h3_text": {
        "text": "Abiaraztea eta jarraipena"
    },
    "sect01_00_d_p01_text": {
        "text": "Lana urrats kudeagarrietan banatzen dugu, berrikuspen zehatzekin eta egiteke dagoenaren ikuspegi argiarekin."
    },
    "sect01_00_d_p02_text": {
        "text": "Argitaratu ondoren, oinarria mantendu eta zabaldu daiteke behar berriak agertu ahala."
    },
    "sect01_00_d_img02": {
        "src": "assets/img/dummy/dummy_900.avif",
        "alt": "Taldea emaitza digital bat prestatzen",
        "title": "Emaitza bat prestatzea"
    },
    "sect01_00_d_img03": {
        "src": "assets/img/dummy/dummy_900.avif",
        "alt": "Zereginen jarraipen-panela",
        "title": "Aurrerapenaren jarraipena"
    },
    "sect01_00_d_img04": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Bilakaerarako prest dagoen proiektu digitala",
        "title": "Hobekuntza berrietarako prestatutako oinarria"
    },

    "moduleH1Type01_00_h1_text": {
        "text": "Jar gaitezen harremanetan zure proiektuari forma emateko"
    },
    "moduleH1Type01_00_p01_text": {
        "text": "Azaldu zer behar duzun eta ideia zer fasetan dagoen."
    },
    "moduleH1Type01_00_p02_text": {
        "text": "Adibideko orri honek elkarrizketa hasteko oinarrizko kanalak eta informazioa biltzen ditu."
    },

    "moduleH2Type01_00_h2_text": {
