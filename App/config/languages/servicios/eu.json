        "title": "Harremanetarako adibidea ikusi"
    },

    "art05_00_headerPrimary": {
        "text": "Pertsonalizatzeko erabilera-adibideak"
    },
    "art05_00_intro_p": {
        "text": "Ondoko testuak argitalpen-adibideak dira. Konposizioa egiaztatzeko balio dute, eta proiektua argitaratu aurretik benetako kasu, lekukotasun edo argudioekin ordezkatu behar dira."
    },
    "art05_00_headerSecondary_a": {
        "text": "Erakunde baten aurkezpena"
    },
    "art05_00_a_img": {
        "src": "/assets/img/system/bookmark-outline.svg",
        "alt": "Aurkezpen-egoera baten ikonoa",
        "title": "Erakunde-aurkezpenaren adibidea"
    },
    "art05_00_a_p": {
        "text": "Konbinatu proposamen argia, azalpen laburra eta lotutako edukietarako estekak, webgunea lehen aldiz bisitatzen duena gidatzeko."
    },
    "art05_00_a_firma": {
        "text": "01 adibidea"
    },
    "art05_00_headerSecondary_b": {
        "text": "Zerbitzuen katalogoa"
    },
    "art05_00_b_img": {
        "src": "/assets/img/system/bookmark-outline.svg",
        "alt": "Zerbitzu-katalogo baten ikonoa",
        "title": "Katalogo modularraren adibidea"
    },
    "art05_00_b_p": {
        "text": "Bildu gaitasunak bloke berrerabilgarrietan, eta eskaini ibilbide erraza zerbitzu bakoitzaren informazio xehera iristeko."
    },
    "art05_00_b_firma": {
        "text": "02 adibidea"
    },
    "art05_00_headerSecondary_c": {
        "text": "Edukiak argitaratzea"
    },
    "art05_00_c_img": {
        "src": "/assets/img/system/bookmark-outline.svg",
        "alt": "Argitalpen digital baten ikonoa",
        "title": "Argitalpen-edukiaren adibidea"
    },
    "art05_00_c_p": {
        "text": "Erabili bloga proiektuaren benetako jarduerarekin lotutako berriak, ezagutza eta baliabideak partekatzeko."
    },
    "art05_00_c_firma": {
        "text": "03 adibidea"
    },
    "art05_00_headerSecondary_d": {
        "text": "Kontsultak jasotzea"
    },
    "art05_00_d_img": {
        "src": "/assets/img/system/bookmark-outline.svg",
        "alt": "Harremanetarako formulario baten ikonoa",
        "title": "Kontsultak jasotzeko adibidea"
    },
    "art05_00_d_p": {
        "text": "Amaitu ibilbidea ekintza-dei ulergarri batekin eta beharrezko datuak soilik eskatzen dituen formularioarekin."
    },
    "art05_00_d_firma": {
        "text": "04 adibidea"
    },

