        "title": "Konfigura daitekeen katalogo digitala"
    },
    "art04_00_b_link": {
        "href": "#",
        "title": "Katalogo-adibidea ikusi"
    },
    "art04_00_c_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Harremanetarako orri baten adibideko ikuspegia",
        "title": "Konfigura daitekeen harremanetarako orria"
    },
    "art04_00_c_link": {
