    "title": {
        "text": "Zerbitzu digitalak | LiquidStack proiektua"
    },

    "description": {
        "content": "Ezagutu zerbitzu digital modular eta editagarrien egitura, LiquidStack proiektu hau erakunde bakoitzaren balio-proposamenera egokitzeko."
    },

    "robots": {
        "content": "index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    },

    "sect02_00_a_h3_text": {
        "text": "Estrategia eta helburu digitalak"
    },
    "sect02_00_a_p01_text": {
        "text": "Orri bakoitzaren helburua, hartzaileak eta ekintza nagusiak zehazten ditugu, hasierako ideia egitura argi eta mantentzen erraz bihurtzeko."
    },
    "sect02_00_a_p02_text": {
        "text": "Adibide-eduki hau proiektu bakoitzaren proposamen, prozesu eta mezu propioekin ordezka daiteke."
    },
    "sect02_00_a_img": {
        "src": "assets/img/dummy/dummy_1200.avif",
        "alt": "Taldea proiektu digital baten estrategia zehazten",
        "title": "Egitura digital moldagarri baten plangintza"
    },
    "sect02_00_a_img_sizes": {
        "text": "(max-width: 899px) 900px, 1800px"
    },
    "sect02_00_a_img_srcset01": "assets/img/dummy/dummy_900.avif 900w",
    "sect02_00_a_img_srcset02": "assets/img/dummy/dummy_1800.avif 1800w",
    "sect02_00_b_h3_text": {
        "text": "Esperientziaren eta edukien diseinua"
    },
    "sect02_00_b_p01_text": {
        "text": "Informazioa, ibilbideak eta osagai bisualak antolatzen ditugu, gailu eta hizkuntza desberdinetan esperientzia koherentea eraikitzeko."
    },
    "sect02_00_b_p02_text": {
        "text": "Moduluek testuak, irudiak eta ekintza-deiak doitzea ahalbidetzen dute, gunearen oinarri teknikoa aldatu gabe."
    },
    "sect02_00_b_img": {
        "src": "assets/img/dummy/dummy_1200.avif",
        "alt": "Pertsonak web-interfaze modular bat berrikusten",
        "title": "Web-esperientzia koherente baten diseinua"
    },
    "sect02_00_b_img_sizes": {
        "text": "(max-width: 899px) 900px, 1800px"
    },
    "sect02_00_b_img_srcset01": "assets/img/dummy/dummy_900.avif 900w",
    "sect02_00_b_img_srcset02": "assets/img/dummy/dummy_1800.avif 1800w",
    "sect02_00_c_h3_text": {
        "text": "Garapena eta etengabeko hobekuntza"
    },
    "sect02_00_c_p01_text": {
        "text": "Oinarri tekniko hedagarria prestatzen dugu, baliabide berrerabilgarriekin eta orri zein funtzionalitate berriak gehitzeko pentsatutako antolaketarekin."
    },
    "sect02_00_c_p02_text": {
        "text": "Neurketak eta mantentze-lanek hobekuntzak lehenesten laguntzen dute, proiektua garatu ahala."
    },
    "sect02_00_c_img": {
        "src": "assets/img/dummy/dummy_1200.avif",
        "alt": "Web-proiektu baten jarraipen-panela",
        "title": "Plataforma digital baten etengabeko bilakaera"
    },
    "sect02_00_c_img_sizes": {
        "text": "(max-width: 899px) 900px, 1800px"
    },
    "sect02_00_c_img_srcset01": "assets/img/dummy/dummy_900.avif 900w",
    "sect02_00_c_img_srcset02": "assets/img/dummy/dummy_1800.avif 1800w",

    "moduleH1Type01_00_h1_text": {
        "text": "Proiektu eskalagarri baterako zerbitzu digitalak"
    },
    "moduleH1Type01_00_p01_text": {
        "text": "Gaitasunak, prozesuak eta proposamenak argi aurkezteko oinarri modularra."
    },
    "moduleH1Type01_00_p02_text": {
        "text": "Egokitu adibide-bloke hauek erakundearen benetako edukira, eta aktibatu proiektuak behar dituen baliabideak soilik."
    },

    "moduleH2Type01_01_h2_text": {
        "text": "Zure beharretara egokitzeko oinarri modularra"
    },

    "moduleButtonType01_00_cta": {
