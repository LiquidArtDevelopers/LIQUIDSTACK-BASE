    "art04_00_headerPrimary": {
        "text": "Konfigura daitezkeen soluzioen adibideak"
    },
    "art04_00_intro_p": {
        "text": "Pieza hauek erakusten dute nola konbinatu edukiak, irudiak eta estekak, oinarri bisual berean hainbat ikuspegi aurkezteko."
    },
    "art04_00_a_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Informazio-orri baten adibideko ikuspegia",
        "title": "Konfigura daitekeen informazio-orria"
    },
    "art04_00_a_link": {
        "href": "#",
        "title": "Informazio-adibidea ikusi"
    },
    "art04_00_b_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
