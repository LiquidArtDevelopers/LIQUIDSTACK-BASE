        "alt": "Aurrera gezia",
        "title": "Kontsultara joan"
    },

    "art03_00_headerPrimary": {
        "text": "Fasetan egituratutako adibideko zerbitzua"
    },
    "art03_00_intro_p": {
        "text": "Konposizio honen bidez zerbitzu bat nola zehaztu, baliozkotu, inplementatu eta hobetu azal daiteke, txantiloia jarduera jakin bati lotu gabe."
    },
    "art03_00_headerSecondary_a": {
        "text": "Azterketa eta irismena"
    },
    "art03_00_a_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Taldea proiektu baten eskakizunak antolatzen",
        "title": "Irismenaren hasierako definizioa"
    },
    "art03_00_a_link": {
        "href": "#",
        "title": "Azterketa-fasea ezagutu"
    },
    "art03_00_a_p": {
        "text": "Bildu helburuak, hartzaileak eta mugak, diseinua hasi aurretik partekatutako lehentasunak ezartzeko."
    },
    "art03_00_headerSecondary_b": {
        "text": "Diseinua eta baliozkotzea"
    },
    "art03_00_b_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Pertsonak interfaze-proposamen bat berrikusten",
        "title": "Proposamen digital baten baliozkotzea"
    },
    "art03_00_b_link": {
        "href": "#",
        "title": "Diseinu-fasea ezagutu"
    },
    "art03_00_b_p": {
        "text": "Egiaztatu arkitektura, edukiak eta ibilbide nagusiak entrega ulergarrien eta berrikuspen mugatuen bidez."
    },
    "art03_00_headerSecondary_c": {
        "text": "Inplementazio modularra"
    },
    "art03_00_c_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Osagai digitalak modulutan antolatuta",
        "title": "Osagai berrerabilgarrien bidezko inplementazioa"
    },
    "art03_00_c_link": {
        "href": "#",
        "title": "Inplementazio-fasea ezagutu"
    },
    "art03_00_c_p": {
        "text": "Eraiki bloke bakoitza oinarri komun baten gainean, aldaketak, berrerabilpena eta etorkizuneko hedapenak errazteko."
    },
    "art03_00_headerSecondary_d": {
        "text": "Neurketa eta bilakaera"
    },
    "art03_00_d_img": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Adibideko adierazleak dituen jarraipen-panela",
        "title": "Zerbitzuaren bilakaeraren jarraipena"
    },
    "art03_00_d_link": {
        "href": "#",
        "title": "Hobekuntza-fasea ezagutu"
    },
    "art03_00_d_p": {
        "text": "Berrikusi funtzionamendua, jaso behar berriak eta lehenetsi hurrengo zikloari balioa emango dioten hobekuntzak."
    },

    "art10_00_headerPrimary": {
        "text": "Hasieratik amaierara arteko prozesu argia"
    },
    "art10_00_headerSecondary_a": {
        "text": "Proiektua prestatzea"
    },
    "art10_00_a_img": {
        "src": "assets/img/system/star-outline.svg",
        "alt": "Prestaketa-zerrenda baten ikonoa",
        "title": "Proiektuaren prestaketa ordenatua"
    },
    "art10_00_a_p": {
        "text": "Helburuak, arduradunak eta entregagaiak adosten ditugu, erabaki bakoitzak parte-hartzaile guztiek ezagutzen duten testuingurua izan dezan."
    },
    "art10_00_headerSecondary_b": {
        "text": "Elkarlanean berrikustea"
    },
    "art10_00_b_img": {
        "src": "assets/img/system/star-outline.svg",
        "alt": "Berrikuspen partekatu baten ikonoa",
        "title": "Aurrerapenen elkarlaneko berrikuspena"
    },
    "art10_00_b_p": {
        "text": "Aurrerapenak etapa kudeagarrietan aurkezten ditugu, eta beharrezko aldaketak erregistratzen ditugu hurrengo blokera igaro aurretik."
    },
    "art10_00_headerSecondary_c": {
        "text": "Emaitza eta jarraipena"
    },
    "art10_00_c_img": {
        "src": "assets/img/system/star-outline.svg",
        "alt": "Proiektuaren jarraipen-ikonoa",
        "title": "Bilakaerarako prestatutako emaitza"
    },
    "art10_00_c_p": {
        "text": "Soluzioa dokumentatzen dugu, eta zerbitzua behar denean mantendu, neurtu eta zabaltzeko oinarri ulergarria uzten dugu."
    },
    "art10_00_top_fill": "#ffffff",
    "art10_00_bottom_fill": "#ffffff",

    "art12_00_headerPrimary": {
        "text": "Proiektuaren arabera aktiba ditzakezun gaitasunak"
    },
    "art12_00_headerSecondary_a": {
        "text": "Edukien kudeaketa"
    },
    "art12_00_a_img": {
        "src": "assets/img/system/star-outline.svg",
        "alt": "Edukien kudeaketaren ikonoa",
        "title": "Eduki editagarri eta antolatua"
    },
    "art12_00_a_imgBack": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Pertsonak interfaze batean edukiak editatzen",
        "title": "Proiektuaren edukien edizioa"
    },
    "art12_00_a_p": {
        "text": "Antolatu testuak, irudiak eta ekintza-deiak, taldeak funtsezko informazioa eguneratuta eduki dezan."
    },
    "art12_00_headerSecondary_b": {
        "text": "Aukerako integrazioak"
    },
    "art12_00_b_img": {
        "src": "assets/img/system/star-outline.svg",
        "alt": "Konexio digitalen ikonoa",
        "title": "Proiektura egokitutako integrazioak"
    },
    "art12_00_b_imgBack": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Tresnen arteko konexioen diagrama",
        "title": "Tresnen konexio modularra"
    },
    "art12_00_b_p": {
        "text": "Konektatu behar diren tresnak soilik, eta mantendu kontratu argiak aurrerago ordezkatu edo zabaltzeko."
    },
    "art12_00_headerSecondary_c": {
        "text": "Mantentzea eta laguntza"
    },
    "art12_00_c_img": {
        "src": "assets/img/system/star-outline.svg",
        "alt": "Mantentze-lanen ikonoa",
        "title": "Zerbitzuaren etengabeko mantentzea"
    },
    "art12_00_c_imgBack": {
        "src": "assets/img/dummy/dummy_2560.avif",
        "alt": "Mantentze-lan digitalen panela",
        "title": "Mantentze-lanen jarraipena"
    },
    "art12_00_c_p": {
        "text": "Planifikatu berrikuspenak, eguneratzeak eta hobekuntzak, proiektuaren benetako bilakaerara egokitutako irismen ulergarri batekin."
    },
