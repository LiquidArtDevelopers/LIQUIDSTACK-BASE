    "moduleH1Type01_00_h1_text": {
        "text": "Zure helburuetara egokitzen den zerbitzu digitala"
    },
    "moduleH1Type01_00_p01_text": {
        "text": "Aurkeztu zerbitzuaren balioa egitura argi, malgu eta editatzeko erraz batekin."
    },
    "moduleH1Type01_00_p02_text": {
        "text": "Ordeztu lagin-eduki hau benetako proiektuaren irismen, prozesu eta emaitza egiaztagarriekin."
    },

    "moduleH2Type01_02_h2_text": {
        "text": "Inplementazioa prestatzeko baliabideak"
    },

    "moduleButtonType01_00_cta": {
        "href": "#",
        "title": "Zerbitzu honi buruz galdetu"
    },
