# === PERFIL DESARROLLO ===
# Solo contiene valores que sobrescriben el .env principal.

# Función: origen público activo. Ejemplo: https://example.com
RAIZ=http://localhost:1309
# Función: activa desarrollo (1) o producción (0). Ejemplo: 1
DEV_MODE=1
# Función: muestra errores PHP con 1. Ejemplo: 0
DISPLAY_ERROR=1
# Función: evita regenerar catálogos con 1. Ejemplo: 1
LANG_SKIP_UPDATE=0
# Función: indica el host modular sin protocolo. Ejemplo: 127.0.0.1
LIQUIDSTACK_DB_HOST=127.0.0.1
