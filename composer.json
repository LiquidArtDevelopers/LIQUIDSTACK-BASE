{
    "name": "liquidstack/base",
    "description": "Proyecto base neutro para iniciar stacks consumidores de LiquidStack.",
    "type": "project",
    "license": "proprietary",
    "homepage": "https://github.com/LiquidArtDevelopers/LIQUIDSTACK-BASE",
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-pdo_mysql": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "liquidstack/core": "^1.35",
        "liquidstack/webadmin": "*",
        "liquidstack/blog": "*",
        "liquidstack/commerce": "*"
    },
    "autoload": {
        "classmap": [
            "tools/ProjectInitializer.php"
        ]
    },
    "scripts": {
        "post-create-project-cmd": [
            "LiquidStackBase\\ProjectInitializer::initialize"
        ],
        "project:init": [
            "LiquidStackBase\\ProjectInitializer::initialize"
        ],
        "release": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/release.php"
        ],
        "test": [
            "@php vendor/bin/phpunit --configuration phpunit.xml --do-not-cache-result"
        ],
        "test:create-project": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/test-create-project.php"
        ],
        "liquidstack-core:sync-resources": [
            "App\\Core\\Composer\\Installer::syncResources"
        ]
    },
    "config": {
        "allow-plugins": {
            "liquidstack/core": true
        }
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.env",
            "/.npmrc",
            "/auth.json",
            "/composer.lock",
            "/.phpunit.result.cache",
            "/.codex/tmp",
            "/.liquidstack/core/sync-transactions",
            "/vendor",
            "/node_modules",
            "/App/tools",
            "/App/bootstrap.php",
            "/storage",
            "/public/.vite",
            "/public/assets/css",
            "/public/assets/js",
            "/public/assets/video/customer"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "support": {
        "source": "https://github.com/LiquidArtDevelopers/LIQUIDSTACK-BASE",
        "issues": "https://github.com/LiquidArtDevelopers/LIQUIDSTACK-BASE/issues"
    }
}
