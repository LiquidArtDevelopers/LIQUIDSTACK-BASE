# -------------------------------------------------------
# DATOS CONFIGURACIÓN DESARROLLO / PRODUCCIÓN

# Host desarrollo/producción 
# RAIZ=https://example.com
RAIZ=http://localhost:1309

# Si el valor es 1 es para desarrollo, 0 para producción.
DEV_MODE=1

# Con valor 1, mostrar errores de servidor
DISPLAY_ERROR=1

# -------------------------------------------------------
# DATOS CONFIGURACIÓN INICIAL DE LA GESTIÓN DE IDIOMAS

# Si es 1, no ejecuta en caliente la actualización del json. Recomendable cuando se tiene ya el copy de la web
LANG_SKIP_UPDATE=0

# Idioma por defecto y principal
LANG_DEFAULT=es

# Si es 1, la url home en el idioma principal será "/" sin lang.
ES_SIMPLIFICADO=1

# Si el valor es '0' significa que la web será idioma único, y no irá el lang en la URL.
MULTILANG=1

# -------------------------------------------------------
# OTROS DATOS DE CONFIGURACIÓN DEL PROYECTO

# DATOS PHPMAILER
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=465
# WebAdmin exige "starttls" o "smtps" y un nombre visible en proyectos nuevos.
MAIL_ENCRYPTION=
MAIL_FROM_NAME=


#correo admin LAD
MAIL_LAD=desarrollo@example.com # correo técnico principal
MAIL_LAD_BIS=soporte@example.com # correo técnico secundario
MAIL_WEB=no-reply@example.com # Correo normal del proyecto
MAIL_ADMIN=admin@example.com # Correo admin del cliente

# DATOS TEMPLATE CORREOS
DOMAIN=example.com
DOMAIN_URL=https://example.com/
EMISOR_NAME='NOMBRE EMPRESA'

# DATOS POLÍTICA DE PRIVACIDAD
VITE_BUSINESS_NAME='Nombre de empresa'
VITE_BUSINESS_ADDRESS='Dirección postal de empresa'
# Alias legacy: mantener solo mientras exista copy antiguo que lo consuma.
VITE_BUSINESS_ADRESS='Dirección postal de empresa'
VITE_BUSINESS_LOCALITY='Localidad'
VITE_BUSINESS_POSTAL_CODE='00000'
VITE_BUSINESS_REGION='Provincia o región'
VITE_BUSINESS_COUNTRY='ES'
VITE_BUSINESS_PHONE=''
VITE_BUSINESS_CIF='NIF/CIF de empresa'
VITE_BUSINESS_WEB='https://example.com'
VITE_BUSINESS_CONTACT='contacto@example.com'

# COOKIE LAD (opcional; dejar vacío para no cargar el widget)
COOKIE_LAD_KEY=
COOKIE_LAD_COLOR=000000

# APIKEY DE GSAP PARA PODER USAR LAS ANIMACIONES
GSAP_TOKEN=

# DATOS BBDD DEMO DE BASE (solo desarrollo local)
# Estos valores son públicos y coinciden con example_liquidstack_dev.sql.
# Crear la DB/usuario localmente o sustituirlos por los del proyecto.
# No desplegar estas credenciales en producción.
BBDD_NAME=example_liquidstack_dev
BBDD_USER=example_user
BBDD_PASS=example_pass
BBDD_SERVER=127.0.0.1

# -------------------------------------------------------
# MÓDULOS LIQUIDSTACK: WEBADMIN Y BLOG

# DEMO PÚBLICA: válida por formato, pero no es secreta ni segura para desplegar.
# Sustituirla por una clave base64url aleatoria de 43 caracteres en cada proyecto.
LIQUIDSTACK_WEBADMIN_SECURITY_KEY=EXAMPLE_ONLY_CHANGE_ME_BEFORE_REAL_USE_0000

# Identidades iniciales de BASE. Cambiarlas si el proyecto tendrá otros admins.
# Tras completar el alta pueden retirarse del entorno privado.
LIQUIDSTACK_WEBADMIN_SYSTEM_SUPERADMIN_EMAIL=aranaz@webda.eus
LIQUIDSTACK_WEBADMIN_SITE_ADMIN_EMAIL=aranaz@gmail.com

# Transporte de correo opcional: "smtp" usa el bloque MAIL_* anterior.
# "local_capture_smtp" requiere un capturador local configurado expresamente.
LIQUIDSTACK_WEBADMIN_MAIL_TRANSPORT=

# Solo para "local_capture_smtp" en desarrollo loopback; no mezclar con smtp.
LIQUIDSTACK_WEBADMIN_SMTP_HOST=
LIQUIDSTACK_WEBADMIN_SMTP_PORT=
LIQUIDSTACK_WEBADMIN_MAIL_FROM_ADDRESS=
LIQUIDSTACK_WEBADMIN_MAIL_FROM_NAME=

# Base de datos modular dedicada (opcional). Si se selecciona "liquidstack"
# en App/config/modules/webadmin.php y blog.php, las seis son obligatorias.
# Si se deja el perfil por defecto "shared", se usan los BBDD_* anteriores.
LIQUIDSTACK_DB_HOST=
LIQUIDSTACK_DB_PORT=
LIQUIDSTACK_DB_NAME=
LIQUIDSTACK_DB_USER=
LIQUIDSTACK_DB_PASSWORD=
LIQUIDSTACK_DB_CHARSET=

# Rutas privadas opcionales de producción, absolutas y fuera del deploy.
# En desarrollo loopback existen defaults internos; Composer no las inicializa.
LIQUIDSTACK_WEBADMIN_MEDIA_STORAGE_ROOT=
LIQUIDSTACK_BLOG_SITEMAP_CACHE_ROOT=





