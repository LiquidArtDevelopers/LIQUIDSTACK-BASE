# Configuración LiquidStack
# No versionar `.env` cuando contenga credenciales reales.

# === ENTORNO ===
# Función: origen público activo. Ejemplo: https://example.com
RAIZ=http://localhost:1309
# Función: activa desarrollo (1) o producción (0). Ejemplo: 1
DEV_MODE=1
# Función: muestra errores PHP con 1. Ejemplo: 0
DISPLAY_ERROR=1

# === IDIOMAS ===
# Función: evita regenerar catálogos con 1. Ejemplo: 1
LANG_SKIP_UPDATE=0
# Función: define el idioma principal. Ejemplo: es
LANG_DEFAULT=es
# Función: sirve el idioma principal desde / con 1. Ejemplo: 1
ES_SIMPLIFICADO=1
# Función: activa rutas multidioma con 1. Ejemplo: 1
MULTILANG=1

# === SMTP COMPARTIDO ===
# Función: indica el servidor SMTP. Ejemplo: smtp.proveedor.com
MAIL_HOST=
# Función: autentica SMTP y define el From. Ejemplo: web@example.com
MAIL_USERNAME=
# Función: guarda la contraseña SMTP. Ejemplo: <secreto>
MAIL_PASSWORD=
# Función: indica el puerto SMTP. Ejemplo: 465
MAIL_PORT=465
# Función: elige el cifrado SMTP. Ejemplo: smtps
MAIL_ENCRYPTION=smtps
# Función: muestra el nombre del remitente. Ejemplo: 'Empresa Ejemplo'
MAIL_FROM_NAME='NOMBRE EMPRESA'

# === DESTINATARIOS DE FORMULARIOS ===
# Función: recibe los formularios públicos. Ejemplo: contacto@example.com
MAIL_ADMIN=admin@example.com
# Función: añade una BCC técnica opcional. Ejemplo: soporte@agencia.com
MAIL_LAD=
# Función: añade una segunda BCC opcional. Ejemplo: qa@agencia.com
MAIL_LAD_BIS=
# Función: mantiene backends de correo legacy. Ejemplo: web@example.com
MAIL_WEB=

# === PLANTILLAS DE CORREO ===
# Función: identifica el dominio sin protocolo. Ejemplo: example.com
DOMAIN=example.com
# Función: define la URL usada en correos. Ejemplo: https://example.com/
DOMAIN_URL=https://example.com/
# Función: nombra la entidad emisora. Ejemplo: 'Empresa Ejemplo'
EMISOR_NAME='NOMBRE EMPRESA'

# === DATOS PÚBLICOS Y LEGALES ===
# Función: publica la razón social. Ejemplo: 'Empresa Ejemplo SL'
VITE_BUSINESS_NAME='Nombre de empresa'
# Función: publica la dirección postal. Ejemplo: 'Calle Mayor 1'
VITE_BUSINESS_ADDRESS='Dirección postal de empresa'
# Función: mantiene el alias legacy de ADDRESS. Ejemplo: 'Calle Mayor 1'
VITE_BUSINESS_ADRESS='Dirección postal de empresa'
# Función: publica la localidad. Ejemplo: Bilbao
VITE_BUSINESS_LOCALITY='Localidad'
# Función: publica el código postal. Ejemplo: 48001
VITE_BUSINESS_POSTAL_CODE='00000'
# Función: publica la provincia o región. Ejemplo: Bizkaia
VITE_BUSINESS_REGION='Provincia o región'
# Función: publica el país en ISO 3166-1. Ejemplo: ES
VITE_BUSINESS_COUNTRY='ES'
# Función: publica el teléfono. Ejemplo: +34944000000
VITE_BUSINESS_PHONE=''
# Función: publica el NIF o CIF. Ejemplo: B12345678
VITE_BUSINESS_CIF='NIF/CIF de empresa'
# Función: publica la web corporativa. Ejemplo: https://example.com
VITE_BUSINESS_WEB='https://example.com'
# Función: publica el correo legal. Ejemplo: contacto@example.com
VITE_BUSINESS_CONTACT='contacto@example.com'

# === COOKIELAD ===
# Función: identifica CookieLad; vacío lo desactiva. Ejemplo: <clave-proyecto>
COOKIE_LAD_KEY=
# Función: define su color hex sin #. Ejemplo: 1a2b3c
COOKIE_LAD_COLOR=000000
# GSAP se autentica mediante .npmrc.example; no pertenece a este .env.

# === DB MODULAR LIQUIDSTACK ===
# Función: indica el host modular sin protocolo. Ejemplo: 127.0.0.1
LIQUIDSTACK_DB_HOST=127.0.0.1
# Función: indica el puerto MySQL/MariaDB. Ejemplo: 3306
LIQUIDSTACK_DB_PORT=3306
# Función: nombra la DB de WebAdmin/Blog/Commerce. Ejemplo: proyecto_liquidstack
LIQUIDSTACK_DB_NAME=example_liquidstack_dev
# Función: identifica su usuario SQL. Ejemplo: proyecto_user
LIQUIDSTACK_DB_USER=example_user
# Función: guarda su contraseña SQL. Ejemplo: <secreto>
LIQUIDSTACK_DB_PASSWORD=example_pass
# Función: define el charset de conexión. Ejemplo: utf8mb4
LIQUIDSTACK_DB_CHARSET=utf8mb4
# BBDD_* se reserva a zonas privadas legacy y no sustituye esta conexión.

# === WEBADMIN ===
# Función: protege sesiones y acciones; cambia la demo. Ejemplo: <43-caracteres-base64url>
LIQUIDSTACK_WEBADMIN_SECURITY_KEY=EXAMPLE_ONLY_CHANGE_ME_BEFORE_REAL_USE_0000
# Función: invita al superadmin técnico inicial. Ejemplo: sysadmin@example.com
LIQUIDSTACK_WEBADMIN_SYSTEM_SUPERADMIN_EMAIL=aranaz@webda.eus
# Función: invita al admin inicial del sitio. Ejemplo: admin@example.com
LIQUIDSTACK_WEBADMIN_SITE_ADMIN_EMAIL=aranaz@gmail.com
# Función: elige SMTP real o captura local. Ejemplo: smtp
LIQUIDSTACK_WEBADMIN_MAIL_TRANSPORT=smtp

# === CAPTURADOR SMTP LOCAL ===
# Función: define el capturador loopback. Ejemplo: 127.0.0.1
LIQUIDSTACK_WEBADMIN_SMTP_HOST=
# Función: define su puerto. Ejemplo: 1025
LIQUIDSTACK_WEBADMIN_SMTP_PORT=
# Función: define su From ficticio. Ejemplo: no-reply@localhost.test
LIQUIDSTACK_WEBADMIN_MAIL_FROM_ADDRESS=
# Función: define su nombre visible. Ejemplo: 'WebAdmin local'
LIQUIDSTACK_WEBADMIN_MAIL_FROM_NAME=

# === STORAGE PRIVADO ===
# Función: ubica los medios persistentes. Ejemplo: C:/storage/proyecto/media
LIQUIDSTACK_WEBADMIN_MEDIA_STORAGE_ROOT=
# Función: ubica la caché del sitemap. Ejemplo: C:/storage/proyecto/sitemap
LIQUIDSTACK_BLOG_SITEMAP_CACHE_ROOT=

# === COMMERCE ===
# Función: recibe las solicitudes de información. Ejemplo: ventas@example.com
LIQUIDSTACK_COMMERCE_INQUIRY_RECIPIENT=
# Función: versiona el consentimiento legal guardado. Ejemplo: v1
LIQUIDSTACK_COMMERCE_PRIVACY_VERSION=v1
# Función: muestra productos ficticios solo en desarrollo. Ejemplo: 1
LIQUIDSTACK_COMMERCE_DEVELOPMENT_FIXTURES=1
